// Typst equivalents of LaTeX font sizes (https://www.sascha-frank.com/latex-font-size.html)
#let size-main = 11pt
#let size-large = 12pt
#let size-Large = 14pt
#let size-LARGE = 17pt
#let size-huge = 20pt
#let size-Huge = 25pt

#let thesis-margin-inside = 3.1cm
#let thesis-margin-outside = 5.1cm
#let thesis-margin-top = 5cm
#let thesis-margin-bottom = 4.7cm

#let first-line-indent = 1.8em

#let block-above = 1.2em
#let block-below = 1.2em

#let par-leading = 0.6em
#let par-spacing = 0.6em

#let heading-above = block-above + 0.5 * par-leading

#let line-stroke = 0.8pt

#let quote-pad = 1.5em
