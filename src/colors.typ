// Colors, taken from the official graphic profile of Lund University
#let lu-bronze = color.spot("PANTONE 1395 U", rgb(156, 97, 20)) //cmyk(9%, 57%, 100%, 41%)
#let lu-blue = color.spot("PANTONE 280 U", rgb(0, 0, 128)) //cmyk(100%, 85%, 5%, 22%)
#let lu-light-pink = color.spot("PANTONE 503 C", rgb(233, 196, 199))
#let lu-light-blue = color.spot("PANTONE 552 C", rgb(185, 211, 220))
#let lu-light-green = color.spot("PANTONE 559 C", rgb(173, 202, 184))
#let lu-light-brown = color.spot("PANTONE 7527 C", rgb(214, 210, 196)) //cmyk(3%, 4%, 14%, 8%)
#let lu-light-grey = color.spot("PANTONE Warm Grey 3", rgb(191, 184, 175))
#let lu-grey = color.spot("PANTONE BLACK 7 C", rgb(77, 76, 68)) //cmyk(0%, 0%, 15%, 85%)

#let bg-colors = (
  "brown": lu-light-brown,
  "green": lu-light-green,
  "grey": lu-light-grey,
  "blue": lu-light-blue,
  "pink": lu-light-pink,
)
